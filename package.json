{
  "name": "scaffold-nextjs-meta",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome check --write",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --passWithNoTests --reporter=dot",
    "test:watch": "vitest",
    "e2e": "playwright test --pass-with-no-tests --reporter=line",
    "verify": "npm run -s typecheck && npm run -s lint && npm run -s check:comments && npm run -s test && npm run -s e2e && npm run -s build",
    "check:comments": "! grep -rnE --include='*.ts' --include='*.tsx' '^[[:space:]]*(//|/\\*|\\*)' src | grep -vE 'kill_switch\\.ts|event_dictionary\\.ts'",
    "bootstrap": "npm ci && npx playwright install chromium && ([ -f .env ] || cp .env.example .env) && npm run verify"
  },
  "dependencies": {
    "next": "16.3.5",
    "nodemailer": "10.0.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@next/env": "16.3.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.5.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "tailwindcss": "^4",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "template": "scaffold-nextjs-meta@1.0.0"
}
